{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64",
      "displayName": "Windows x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64"
    },
    {
      "name": "win32",
      "displayName": "Windows Win32",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/win32"
    }
  ],
  "buildPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release"
    },
    {
      "name": "win32-release",
      "configurePreset": "win32",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-release",
      "configurePreset": "x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "win32-release",
      "configurePreset": "win32",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
